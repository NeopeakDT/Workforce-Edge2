# Environment Variables for Workforce Management System
# Copy this file to .env and update with your actual values

# Database Configuration
# Format: postgresql://user:password@host:port/database
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/workforce_db

# Supabase Configuration (if using Supabase client)
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# Application Configuration
# API_HOST=0.0.0.0
# API_PORT=8000

# Security
# JWT_SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
