# Workforce Backend Service (API)
#
# What it does:
# - Runs the Workforce FastAPI backend with Uvicorn.
# - Exposes API on port 8000 for edge ingestion and backend endpoints.
#
# How to use:
# 1) sudo cp systemd/workforce-backend.service /etc/systemd/system/workforce-backend.service
# 2) sudo systemctl daemon-reload
# 3) sudo systemctl enable workforce-backend
# 4) sudo systemctl start workforce-backend
# 5) sudo systemctl status workforce-backend --no-pager
# 6) journalctl -u workforce-backend -f

[Unit]
Description=Workforce Backend API
After=network.target

[Service]
WorkingDirectory=/home/neopeak/Desktop/workforce/Edge2/backend
ExecStart=/home/neopeak/edge2/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
User=neopeak

[Install]
WantedBy=multi-user.target
