# ------------------------------------------------------------------------------
# Workforce Edge Detector Service (Jetson)
#
# Purpose:
# Runs the edge AI pipeline (multi-camera detection + event sending) as a
# background system service. Automatically restarts on crash and ensures
# system is production-ready (no manual terminal needed).
#
# What it does:
# - Runs jetson/edge_detector.py using virtual environment
# - Performs precheck before start (backend, GPU, model)
# - Auto-restarts on failure
# - Logs output via journalctl
#
# How to use:
# Start:    sudo systemctl start workforce-edge
# Stop:     sudo systemctl stop workforce-edge
# Restart:  sudo systemctl restart workforce-edge
# Status:   sudo systemctl status workforce-edge
# Logs:     journalctl -u workforce-edge -f
#
# Notes:
# - For testing (video files): service will stop after video ends
# - For production (RTSP): runs continuously
# ----------------------------------------------------------------------------------------------------------
[Unit]
Description=Workforce Edge Detector (Jetson)
After=network-online.target
Wants=network-online.target

# Prevent rapid crash loops, but don't let transient RTSP/camera flakiness
# permanently park the unit in a failed state that only reset-failed can
# clear (see the 2026-08-27/28 ~27h outage: 5 restarts in 60s was easy for
# a flapping camera stream to burn through in well under a minute).
# workforce-watchdog.service now calls reset-failed as a safety net (see
# jetson/edge_watchdog.py), but the goal here is for systemd's own fast
# Restart=always path to absorb this instead of ever needing that net.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple

# Project root
WorkingDirectory=/home/neopeak/Desktop/workforce/Edge2

# Bootstrap config sync (MANDATORY)
ExecStartPre=/home/neopeak/edge2/bin/python /home/neopeak/Desktop/workforce/Edge2/jetson/edge_config_sync.py

# Precheck (CRITICAL)
ExecStartPre=/home/neopeak/Desktop/workforce/Edge2/systemd/edge_precheck.sh

# Main process (NO activate)
ExecStart=/home/neopeak/edge2/bin/python jetson/edge_detector.py

# Restart policy
Restart=always
RestartSec=5

# Kill all threads properly
KillMode=control-group
TimeoutStopSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Environment safety
Environment=PYTHONUNBUFFERED=1

# User
User=neopeak

# Resource limits (important for TensorRT stability)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
